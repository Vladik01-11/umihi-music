        uid = extras?.getString(Constants.ExoPlayer.SongMetadata.UID).toStringOrEmpty(),
        youtubeId = this?.mediaId.toStringOrEmpty(),
        title = this?.mediaMetadata?.title.toStringOrEmpty(),
